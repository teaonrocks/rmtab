{
  "manifest_version": 3,
  "name": "RmTab",
  "version": "1.0.0",
  "description": "Automatically close tabs that haven't been accessed within a configurable time limit.",
  "permissions": ["tabs", "storage", "alarms", "contextMenus"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RmTab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
